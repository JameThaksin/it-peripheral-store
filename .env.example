# Copy to .env (never commit .env). Names only; no real values here.
NODE_ENV=development
PORT=4000
# Local: Docker replica set (see README). Production: MongoDB Atlas SRV URI from the host's secret store.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB_NAME=itps_dev
